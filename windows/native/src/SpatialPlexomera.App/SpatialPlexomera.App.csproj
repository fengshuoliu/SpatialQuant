<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SpatialPlexomera</AssemblyName>
    <RootNamespace>SpatialPlexomera.Windows</RootNamespace>
    <ApplicationIcon>..\..\..\desktop\assets\SpatialPlexomera.ico</ApplicationIcon>
    <Version>1.4.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>SpatialPlexomera</Authors>
    <Product>SpatialPlexomera for Windows</Product>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Resource Include="..\..\..\desktop\assets\SpatialPlexomera.png" Link="Assets\SpatialPlexomera.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpatialPlexomera.Updater\SpatialPlexomera.Updater.csproj" />
  </ItemGroup>

</Project>
