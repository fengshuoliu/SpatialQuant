<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SpatialQuant</AssemblyName>
    <RootNamespace>SpatialQuant.Windows</RootNamespace>
    <ApplicationIcon>..\..\..\desktop\assets\SpatialQuant.ico</ApplicationIcon>
    <Version>1.3.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>SpatialQuant</Authors>
    <Product>SpatialQuant for Windows</Product>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Resource Include="..\..\..\desktop\assets\SpatialQuant.png" Link="Assets\SpatialQuant.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpatialQuant.Updater\SpatialQuant.Updater.csproj" />
  </ItemGroup>

</Project>
