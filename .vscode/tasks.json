{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SpatialPlexomera: Setup Native Windows",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\windows\\run_native.ps1",
        "setup"
      ],
      "problemMatcher": []
    },
    {
      "label": "SpatialPlexomera: Compile Native Windows",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}\\windows\\native\\src\\SpatialPlexomera.App\\SpatialPlexomera.App.csproj",
        "--configuration",
        "Debug"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "SpatialPlexomera: Build Native Windows",
      "dependsOrder": "sequence",
      "dependsOn": [
        "SpatialPlexomera: Setup Native Windows",
        "SpatialPlexomera: Compile Native Windows"
      ],
      "problemMatcher": []
    },
    {
      "label": "SpatialPlexomera: Run Native Windows App",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\windows\\run_native.ps1",
        "run"
      ],
      "problemMatcher": []
    },
    {
      "label": "SpatialPlexomera: Test Native Windows",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\windows\\run_native.ps1",
        "test"
      ],
      "problemMatcher": []
    },
    {
      "label": "SpatialPlexomera: Build Native Windows Release",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\windows\\build_native.ps1",
        "-FullSmoke"
      ],
      "problemMatcher": []
    }
  ]
}
